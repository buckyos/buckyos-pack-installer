#!/bin/zsh
set -e
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
BUCKYOS_ROOT="${BUCKYOS_ROOT:-/opt/buckyos}"
BINDING_FILE="$BUCKYOS_ROOT/etc/desktop_runtime.json"
RUNTIME_LABEL="com.buckyos.runtime"
# Pre-LaunchAgent installs registered these; they are removed, never reused.
LEGACY_DAEMON_PLIST="/Library/LaunchDaemons/buckyos.service.plist"
LEGACY_AGENT_PLIST="/Library/LaunchAgents/buckyos.service.plist"

run_with_timeout() {
  # macOS doesn't ship GNU timeout; use perl alarm for a best-effort timeout.
  # Usage: run_with_timeout 10 command args...
  local seconds="$1"
  shift
  /usr/bin/perl -e '$t=shift; alarm $t; exec @ARGV' "$seconds" "$@"
}

bound_user() {
  local user
  [ -f "$BINDING_FILE" ] || return 0
  user="$(/usr/bin/plutil -extract user raw -o - "$BINDING_FILE" 2>/dev/null)" || return 0
  printf '%s\n' "$user"
}

console_user() {
  local user
  user="$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || true)"
  case "$user" in
    ""|root|loginwindow|_mbsetupuser) return 0 ;;
  esac
  printf '%s\n' "$user"
}

print_docker_help() {
  cat >&2 <<'EOF2'
[buckyos] preinstall: BuckyOS apps run in Docker containers of the Runtime user.
[buckyos] preinstall: Install and start OrbStack (https://orbstack.dev/download) for that user;
[buckyos] preinstall: the Runtime keeps waiting for Docker and deploys apps once it is ready.
EOF2
}

check_user_docker() {
  local user="$1"
  if [ -z "$user" ]; then
    echo "[buckyos] preinstall: no Runtime user yet; Docker is checked in that user's session later"
    return 0
  fi
  echo "[buckyos] preinstall: checking Docker for $user"
  if ! /usr/bin/sudo -u "$user" -H /bin/sh -c "PATH='$PATH'; command -v docker" >/dev/null 2>&1; then
    echo "[buckyos] preinstall: docker CLI not found for $user" >&2
    print_docker_help
    return 0
  fi
  if ! run_with_timeout 15 /usr/bin/sudo -u "$user" -H /bin/sh -c "PATH='$PATH'; docker info" >/dev/null 2>&1; then
    echo "[buckyos] preinstall: Docker is not reachable for $user right now" >&2
    print_docker_help
  fi
}

stop_legacy_services() {
  if [ -f "$LEGACY_DAEMON_PLIST" ]; then
    echo "[buckyos] preinstall: removing legacy system LaunchDaemon $LEGACY_DAEMON_PLIST"
    # Don't use kickstart here: it may start (or wait for) the job and block in installer context.
    launchctl disable "system/buckyos.service" >/dev/null 2>&1 || true
    run_with_timeout 10 launchctl bootout system "$LEGACY_DAEMON_PLIST" >/dev/null 2>&1 || true
    rm -f "$LEGACY_DAEMON_PLIST" >/dev/null 2>&1 || true
  fi
  if [ -f "$LEGACY_AGENT_PLIST" ]; then
    local user uid
    user="$(console_user)"
    if [ -n "$user" ]; then
      uid="$(/usr/bin/id -u "$user" 2>/dev/null || true)"
      [ -n "$uid" ] && run_with_timeout 10 launchctl bootout "gui/$uid" "$LEGACY_AGENT_PLIST" >/dev/null 2>&1 || true
    fi
    rm -f "$LEGACY_AGENT_PLIST" >/dev/null 2>&1 || true
  fi
}

stop_runtime() {
  local user uid
  user="$(bound_user)"
  if [ -n "$user" ]; then
    uid="$(/usr/bin/id -u "$user" 2>/dev/null || true)"
    if [ -n "$uid" ]; then
      echo "[buckyos] preinstall: stopping $RUNTIME_LABEL of $user before replacing the Runtime"
      run_with_timeout 40 launchctl bootout "gui/$uid/$RUNTIME_LABEL" >/dev/null 2>&1 || true
    fi
  fi
  if [ -f "$BUCKYOS_ROOT/bin/stop_osx.sh" ]; then
    run_with_timeout 60 /usr/bin/env BUCKYOS_ROOT="$BUCKYOS_ROOT" /bin/sh "$BUCKYOS_ROOT/bin/stop_osx.sh" || {
      echo "[buckyos] preinstall: existing stop_osx.sh failed" >&2
    }
  fi
}

TARGET_USER="$(bound_user)"
[ -n "$TARGET_USER" ] || TARGET_USER="$(console_user)"
check_user_docker "$TARGET_USER"

echo "[buckyos] preinstall: stopping service (best effort)"
stop_legacy_services
stop_runtime

echo "[buckyos] preinstall: remove module paths (keep data)"
# BEGIN AUTO-GENERATED: modules
rm -rf "$BUCKYOS_ROOT/bin/node-daemon"
rm -rf "$BUCKYOS_ROOT/bin/system-config"
rm -rf "$BUCKYOS_ROOT/bin/verify-hub"
rm -rf "$BUCKYOS_ROOT/bin/scheduler"
rm -rf "$BUCKYOS_ROOT/bin/task-manager"
rm -rf "$BUCKYOS_ROOT/bin/kmsg"
rm -rf "$BUCKYOS_ROOT/bin/control-panel"
rm -rf "$BUCKYOS_ROOT/bin/control-panel/web"
rm -rf "$BUCKYOS_ROOT/bin/smb-service"
rm -rf "$BUCKYOS_ROOT/bin/nfs-server"
rm -rf "$BUCKYOS_ROOT/bin/repo-service"
rm -rf "$BUCKYOS_ROOT/bin/node-active"
rm -rf "$BUCKYOS_ROOT/bin/buckyos_systest"
rm -rf "$BUCKYOS_ROOT/bin/aicc"
rm -rf "$BUCKYOS_ROOT/bin/msg-center"
rm -rf "$BUCKYOS_ROOT/bin/opendan"
rm -rf "$BUCKYOS_ROOT/etc/scheduler"
rm -rf "$BUCKYOS_ROOT/etc/boot_gateway.yaml"
rm -rf "$BUCKYOS_ROOT/bin/util.py"
rm -rf "$BUCKYOS_ROOT/bin/stop.py"
rm -rf "$BUCKYOS_ROOT/bin/stop_osx.sh"
rm -rf "$BUCKYOS_ROOT/bin/buckyos_jarvis"
rm -rf "$BUCKYOS_ROOT/bin/cyfs-gateway"
rm -rf "$BUCKYOS_ROOT/bin/test-server"
# END AUTO-GENERATED: modules
