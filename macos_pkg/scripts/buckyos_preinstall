#!/bin/zsh
set -e
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
BUCKYOS_ROOT="${BUCKYOS_ROOT:-/opt/buckyos}"
DAEMON_PLIST="/Library/LaunchDaemons/buckyos.service.plist"
AGENT_PLIST="/Library/LaunchAgents/buckyos.service.plist"

run_with_timeout() {
  # macOS doesn't ship GNU timeout; use perl alarm for a best-effort timeout.
  # Usage: run_with_timeout 10 command args...
  local seconds="$1"
  shift
  /usr/bin/perl -e '$t=shift; alarm $t; exec @ARGV' "$seconds" "$@"
}

stop_buckyos_containers() {
  echo "[buckyos] preinstall: stopping BuckyOS docker containers (best effort)"
  local raw_container_ids
  local container_ids
  raw_container_ids="$(desktop_as_user docker ps -aq --filter "label=buckyos.app_instance_id" 2>/dev/null || true)"
  if [ -z "$raw_container_ids" ]; then
    echo "[buckyos] preinstall: no BuckyOS docker containers found"
    return
  fi
  container_ids=("${(@f)raw_container_ids}")

  desktop_as_user docker rm -f "${container_ids[@]}" >/dev/null 2>&1 || {
    echo "[buckyos] preinstall: failed to remove BuckyOS docker containers" >&2
  }
}

run_existing_stop_script() {
  echo "[buckyos] preinstall: running existing stop script (best effort)"
  if [ -f "$BUCKYOS_ROOT/bin/stop_osx.sh" ]; then
    run_with_timeout 30 /bin/sh "$BUCKYOS_ROOT/bin/stop_osx.sh" >/dev/null 2>&1 || {
      echo "[buckyos] preinstall: existing stop_osx.sh failed" >&2
    }
    return
  fi

  if [ -f "$BUCKYOS_ROOT/bin/stop.py" ] && command -v python3 >/dev/null 2>&1; then
    run_with_timeout 30 python3 "$BUCKYOS_ROOT/bin/stop.py" >/dev/null 2>&1 || {
      echo "[buckyos] preinstall: existing stop.py failed" >&2
    }
    return
  fi

  if [ "${PRODUCT_RUNS_CONTAINERS:-1}" = "1" ]; then
    stop_buckyos_containers
  fi
}

SCRIPT_DIR="${0:A:h}"
if [[ -f "$SCRIPT_DIR/desktop_mode.zsh" ]]; then source "$SCRIPT_DIR/desktop_mode.zsh"; else source "$SCRIPT_DIR/MODE.zsh"; fi
if [[ -n "${BUCKYOS_SELECTED_EDITION:-}" ]]; then
  SELECTED_EDITION="$BUCKYOS_SELECTED_EDITION"
else
  SELECTED_EDITION="$(desktop_select_mode "$BUCKYOS_ROOT" "${BUCKYOS_INSTALL_SILENT:-0}" "${BUCKYOS_INSTALL_LITE:-0}" 0)" || exit 1
  [[ "$(desktop_profile_edition "$SCRIPT_DIR/profiles/$SELECTED_EDITION.json")" == "$SELECTED_EDITION" ]] || exit 1
  print -r -- "$SELECTED_EDITION" > "$SCRIPT_DIR/selected-mode"
fi
case "$SELECTED_EDITION" in full) PRODUCT_RUNS_CONTAINERS=1 ;; lite) PRODUCT_RUNS_CONTAINERS=0 ;; *) exit 1 ;; esac

echo "[buckyos] preinstall: stopping service (best effort)"
# A Runtime installed for a desktop user stops through its own control path.
OLD_RUNTIME="$BUCKYOS_ROOT/bin/node-daemon/BuckyOS Runtime.app/Contents/MacOS/node_daemon"
if [ -x "$OLD_RUNTIME" ]; then
  run_with_timeout 60 "$OLD_RUNTIME" service stop --root "$BUCKYOS_ROOT" >/dev/null 2>&1 || {
    echo "[buckyos] preinstall: stopping the installed BuckyOS Runtime failed" >&2
  }
fi
# Don't use kickstart here: it may start (or wait for) the job and block in installer context.
launchctl disable "system/buckyos.service" >/dev/null 2>&1 || true
run_with_timeout 10 launchctl bootout system "$DAEMON_PLIST" >/dev/null 2>&1 || true
rm -f "$DAEMON_PLIST" >/dev/null 2>&1 || true

CONSOLE_USER="$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || true)"
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ "$CONSOLE_USER" != "loginwindow" ]; then
  CONSOLE_UID="$(/usr/bin/id -u "$CONSOLE_USER" 2>/dev/null || true)"
  if [ -n "$CONSOLE_UID" ]; then
    run_with_timeout 10 launchctl bootout "gui/$CONSOLE_UID" "$AGENT_PLIST" >/dev/null 2>&1 || true
  fi
fi
rm -f "$AGENT_PLIST" >/dev/null 2>&1 || true

run_existing_stop_script

echo "[buckyos] preinstall: remove module paths (keep data)"
# BEGIN AUTO-GENERATED: modules
rm -rf "$BUCKYOS_ROOT/bin/node-daemon"
rm -rf "$BUCKYOS_ROOT/bin/system-config"
rm -rf "$BUCKYOS_ROOT/bin/verify-hub"
rm -rf "$BUCKYOS_ROOT/bin/scheduler"
rm -rf "$BUCKYOS_ROOT/bin/task-manager"
rm -rf "$BUCKYOS_ROOT/bin/kmsg"
rm -rf "$BUCKYOS_ROOT/bin/control-panel"
rm -rf "$BUCKYOS_ROOT/bin/control-panel/web"
rm -rf "$BUCKYOS_ROOT/bin/smb-service"
rm -rf "$BUCKYOS_ROOT/bin/nfs-server"
rm -rf "$BUCKYOS_ROOT/bin/repo-service"
rm -rf "$BUCKYOS_ROOT/bin/node-active"
rm -rf "$BUCKYOS_ROOT/bin/buckyos_systest"
rm -rf "$BUCKYOS_ROOT/bin/aicc"
rm -rf "$BUCKYOS_ROOT/bin/msg-center"
rm -rf "$BUCKYOS_ROOT/bin/opendan"
rm -rf "$BUCKYOS_ROOT/etc/scheduler"
rm -rf "$BUCKYOS_ROOT/etc/boot_gateway.yaml"
rm -rf "$BUCKYOS_ROOT/bin/util.py"
rm -rf "$BUCKYOS_ROOT/bin/stop.py"
rm -rf "$BUCKYOS_ROOT/bin/stop_osx.sh"
rm -rf "$BUCKYOS_ROOT/bin/buckyos_jarvis"
rm -rf "$BUCKYOS_ROOT/bin/cyfs-gateway"
rm -rf "$BUCKYOS_ROOT/bin/test-server"
# END AUTO-GENERATED: modules
