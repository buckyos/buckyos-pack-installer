BUCKYOS_ROOT="/opt/buckyos"
DEFAULTS_DIR="$BUCKYOS_ROOT/.buckyos_installer_defaults"

ensure_mutable_dir() {
  local path="$1"
  mkdir -p "$path"
  chmod 0777 "$path"
}

if [ -d "$DEFAULTS_DIR" ]; then
  # BEGIN AUTO-GENERATED: data_paths
  :
  # END AUTO-GENERATED: data_paths
fi

# Keep package content at package-defined permissions; only mutable runtime roots
# need wide write access for host services and containerized agents.
ensure_mutable_dir "$BUCKYOS_ROOT/data"
ensure_mutable_dir "$BUCKYOS_ROOT/data/home"
ensure_mutable_dir "$BUCKYOS_ROOT/data/cache"
ensure_mutable_dir "$BUCKYOS_ROOT/data/srv"
ensure_mutable_dir "$BUCKYOS_ROOT/data/var"
ensure_mutable_dir "$BUCKYOS_ROOT/local"
ensure_mutable_dir "$BUCKYOS_ROOT/logs"
ensure_mutable_dir "$BUCKYOS_ROOT/storage"

START_CONFIG_SOURCE="$BUCKYOS_ROOT/etc/start_config.json"
START_CONFIG_SECURITY_ROOT="${BUCKYOS_SECURITY_ROOT:-$BUCKYOS_ROOT/security}"
START_CONFIG_TARGET="$START_CONFIG_SECURITY_ROOT/start_config.json"
if [ -e "$START_CONFIG_SOURCE" ] || [ -L "$START_CONFIG_SOURCE" ]; then
  if [ ! -f "$START_CONFIG_SOURCE" ] || [ -L "$START_CONFIG_SOURCE" ] || [ -L "$START_CONFIG_SECURITY_ROOT" ] || [ -L "$START_CONFIG_TARGET" ]; then
    echo "Cannot move startup config: expected regular files and a non-linked security directory" >&2
    exit 1
  fi
  mkdir -p "$START_CONFIG_SECURITY_ROOT"
  if [ -e "$START_CONFIG_TARGET" ]; then
    if [ ! -f "$START_CONFIG_TARGET" ] || ! cmp -s "$START_CONFIG_SOURCE" "$START_CONFIG_TARGET"; then
      echo "Startup config conflict: $START_CONFIG_SOURCE and $START_CONFIG_TARGET differ; resolve them before reinstalling" >&2
      exit 1
    fi
    chmod 600 "$START_CONFIG_TARGET"
    rm "$START_CONFIG_SOURCE"
  else
    chmod 600 "$START_CONFIG_SOURCE"
    mv "$START_CONFIG_SOURCE" "$START_CONFIG_TARGET"
  fi
  echo "Startup config moved to $START_CONFIG_TARGET"
fi

cat <<EOF > /etc/systemd/system/buckyos.service
[Unit]
Description=buckyos node daemon
After=network.target

[Service]
ExecStart=/opt/buckyos/bin/node-daemon/node_daemon --enable_active
User=root
WorkingDirectory=/opt/buckyos/bin
Restart=always
KillMode=process

[Install]
WantedBy=multi-user.target
EOF

systemctl stop buckyos.service >/dev/null 2>&1 || true
systemctl daemon-reload
systemctl enable buckyos.service
systemctl start buckyos.service

echo "BuckyOS install success, open http://127.0.0.1:3182/index.html to start, ENJOY!"
